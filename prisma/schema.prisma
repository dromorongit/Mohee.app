generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  STUDENT @map("student")
  CREATOR @map("creator")
}

enum NotificationType {
  LIKE @map("like")
  COMMENT @map("comment")
  FOLLOW @map("follow")
}

enum ReportTargetType {
  POST @map("post")
  USER @map("user")
}

enum ReportStatus {
  OPEN @map("open")
  REVIEWED @map("reviewed")
  RESOLVED @map("resolved")
}

model User {
  id                String       @id @default(uuid()) @db.Uuid @map("id")
  email             String       @unique @map("email")
  emailVerified     DateTime?    @map("email_verified")
  username          String?      @unique @map("username")
  displayName       String?      @map("display_name")
  userType          UserType?    @map("user_type")
  bio               String?      @map("bio")
  school            String?      @map("school")
  profileImageUrl   String?      @map("profile_image_url")
  isActive          Boolean      @default(true) @map("is_active")
  isAdmin           Boolean      @default(false) @map("is_admin")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  posts             Post[]
  likes             Like[]
  comments          Comment[]
  notifications     Notification[] @relation("NotificationRecipient")
  feedback          Feedback[]
  following         Follow[]     @relation("Follower")
  followers         Follow[]     @relation("Following")
  blocking          Block[]      @relation("Blocker")
  blockedBy         Block[]      @relation("Blocked")

  @@map("users")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid @map("id")
  userId            String   @db.Uuid @map("user_id")
  type              String   @map("type")
  provider          String   @map("provider")
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @map("refresh_token")
  access_token      String?  @map("access_token")
  expires_at        Int?     @map("expires_at")
  token_type        String?  @map("token_type")
  scope             String?  @map("scope")
  id_token          String?  @map("id_token")
  session_state     String?  @map("session_state")
  oauth_token_secret String? @map("oauth_token_secret")
  oauth_token       String?  @map("oauth_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "account_provider_provider_account_id_key")
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid @map("id")
  sessionToken String   @unique @map("session_token")
  userId       String   @db.Uuid @map("user_id")
  expires      DateTime @map("expires")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String @map("identifier")
  token      String @unique @map("token")
  expires    DateTime @map("expires")

  @@unique([identifier, token], name: "verification_token_identifier_token_key")
  @@map("verification_tokens")
}

model AllowedEmail {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  email     String   @unique @map("email")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_emails")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  userId    String   @db.Uuid @map("user_id")
  text      String   @map("text")
  imageUrl  String?  @map("image_url")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         Like[]
  comments      Comment[]
  notifications Notification[] @relation("PostNotifications")

  @@index([userId], name: "idx_posts_user_id")
  @@index([createdAt], name: "idx_posts_created_at")
  @@map("posts")
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  userId    String   @db.Uuid @map("user_id")
  postId    String   @db.Uuid @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId], name: "like_user_id_post_id_key")
  @@map("likes")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  userId    String   @db.Uuid @map("user_id")
  postId    String   @db.Uuid @map("post_id")
  text      String   @map("text")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt], name: "idx_comments_post_id_created_at")
  @@map("comments")
}

model Follow {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  followerId String   @db.Uuid @map("follower_id")
  followingId String   @db.Uuid @map("following_id")
  createdAt DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId], name: "follow_follower_id_following_id_key")
  @@map("follows")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  userId    String   @db.Uuid @map("user_id")
  actorId   String   @db.Uuid @map("actor_id")
  type      NotificationType @map("type")
  postId    String?  @db.Uuid @map("post_id")
  commentId String?  @db.Uuid @map("comment_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  post Post?  @relation("PostNotifications", fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt], name: "idx_notifications_user_id_is_read_created_at")
  @@map("notifications")
}

model Report {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  reporterId String   @db.Uuid @map("reporter_id")
  targetType ReportTargetType @map("target_type")
  targetId   String   @db.Uuid @map("target_id")
  reason     String   @map("reason")
  details    String?  @map("details")
  status     ReportStatus @default(OPEN) @map("status")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid @map("id")
  blockerId String   @db.Uuid @map("blocker_id")
  blockedId String   @db.Uuid @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], name: "block_blocker_id_blocked_id_key")
  @@map("blocks")
}

model Feedback {
  id                String   @id @default(uuid()) @db.Uuid @map("id")
  userId            String   @db.Uuid @map("user_id")
  rating            Int      @map("rating")
  whatWorked        String?  @map("what_worked")
  whatDidNotWork    String?  @map("what_did_not_work")
  suggestions       String?  @map("suggestions")
  screenshotUrl     String?  @map("screenshot_url")
  issueDescription  String?  @map("issue_description")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
}
